# ============================================
# AI Personal Receptionist - Environment Config
# ============================================
# Copy this file to `.env` and fill in your real values.
# `.env` is git-ignored and must NEVER be committed.
#
#   cp .env.example .env
# ============================================

# --- Telegram notifications -------------------
# Bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Your personal Telegram chat id (get it from @userinfobot)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Optional / reserved configuration ---------
# Ollama local LLM server (used by ai_agent.py)
OLLAMA_URL=http://127.0.0.1:11434

# Default Ollama model
AI_MODEL=phi3:latest

# Owner name shown in the receptionist greeting
OWNER_NAME=Rakshak

# Gemini API key (reserved for the Gemini backup agent)
GEMINI_API_KEY=your_gemini_api_key_here
