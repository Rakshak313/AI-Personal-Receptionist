# ============================================
# AI Personal Receptionist - .gitignore
# ============================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.ipynb_checkpoints/

# --- Virtual environment ---
venv/
.venv/
env/
ENV/

# --- Secrets / environment files ---
.env
.env.*
!.env.example

# --- Database files (call records) ---
calls.db
*.db
*.sqlite
*.sqlite3

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editors / IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- Logs & temp ---
*.log
*.bak
*.tmp
